# PostgreSQL server hostname or IP address.
DB_HOST=localhost

# PostgreSQL server port.
DB_PORT=5432

# PostgreSQL database name used by the cargo backend.
DB_NAME=Waafi_Cargo_Trv_agncy

# PostgreSQL username with access to the application database.
DB_USER=postgres

# PostgreSQL password for the database user.
DB_PASSWORD=123

# Set to true when your PostgreSQL server requires SSL, otherwise false.
DB_SSL=false

# Secret key used to sign and verify JWT access tokens.
JWT_SECRET=d1aa255e79ec96bf3ed4d36d3fade096a669223794befe7191762936865261878a7eddb01fd90b9c86e25177f44ef125ad93355690cd7f7d7ffcc04017454c64

# JWT token lifetime passed directly to jsonwebtoken, for example 8h, 1d, or 30m.
JWT_EXPIRES_IN=8h

# HTTP port the Express server listens on.
PORT=9999

# Comma-separated list of frontend origins allowed to call the API with CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Application runtime environment value used for local setup and deployment profiles.
NODE_ENV=development
